# Copy to .env and fill in. .env is git-ignored -- never commit real values.
#
# For local dev only API_BASE_URL and USE_MOCK_DATA matter; `vite dev` handles the
# rest. On Coolify these are set in the app's environment, not in a .env file, and
# PORT and ORIGIN become relevant because the app then runs behind the proxy.

# Base path of the analyst API, including /api and without a trailing slash.
#
# Read server-side only, so on Coolify this should be the API's internal address --
# the browser never sees it and the API stays unpublished:
#   API_BASE_URL=http://<api-internal-host>:8082/api
# Locally, point it at wherever you are running analyst-api:
API_BASE_URL="http://localhost:8082/api"

# true serves everything from src/lib/server/mocks instead of calling the API.
USE_MOCK_DATA=false

# --- Deployment (docker-compose.yml) ---

# The dashboard's own public URL, scheme included, no trailing slash. adapter-node
# compares it against the Origin header on every form action POST; if it is wrong or
# missing, logging in fails with "Cross-site POST form submissions are forbidden".
ORIGIN=https://dashboard.example.com

PORT=3000
