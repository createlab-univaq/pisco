# Copy to .env and fill in. .env is git-ignored -- never commit real values.
#
# On Coolify these are set in the app's environment, not in a .env file, and the two
# marked BUILD below must be flagged "Build Variable" there.

# BUILD. Base path of the analyst API, including /api and without a trailing slash.
#
# next inlines this into the client bundle, and the browser loads question images
# straight from it, so it has to be the API's public URL -- an internal Coolify
# hostname will build fine and then 404 every image preview.
NEXT_PUBLIC_API_BASE_URL="https://api.example.com/api"

# BUILD. Ceiling for the server action that carries a base64 image upload. The wire
# payload is about a third larger than the file, so leave headroom over the API's
# own IMAGE_MAX_SIZE.
MAX_UPLOAD_SIZE=10mb

# true serves everything from src/lib/server/mocks instead of calling the API.
USE_MOCK_DATA=false

PORT=3000
