MONGO_URI = INSERISCI_LA_TUA_STRINGA_MONGODB
JWT_SECRET=INSERISCI_LA_TUA_SECRET_KEY
JWT_EXPIRES_IN=1h

# Backend Polyglot, interrogato lato server da GET /percorsi per la lista dei
# flow. Nessuno slash finale. POLYGLOT_SERVICE_TOKEN deve coincidere con la
# APP_SERVICE_TOKEN del backend.
POLYGLOT_API_URL=http://localhost:5000
POLYGLOT_SERVICE_TOKEN=INSERISCI_LO_STESSO_TOKEN_DEL_BACKEND
