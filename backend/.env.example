# Database Configuration
MONGODB_URI=mongodb://admin:SECRET@localhost:27017/polyglot?authSource=admin

# MinIO / S3 Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secure_password_here
S3_BUCKET=polyglot-uploads-dev
S3_REGION=us-east-1

# Application Configuration
CORS_ORIGINS=http://localhost:3000
COOKIE_KEY=your_secure_random_cookie_key_here
TEST_MODE=true

# External Services (Google Sign-In & OpenAI)
OPENAI_SECRET_KEY=your_openai_secret_key_here
OPENAI_ENDPOINT=https://api.openai.com/v1

# Must be the same OAuth client id the editor signs in with: it is the
# `aud` every incoming Google ID token is checked against.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com