# Database Configuration
MONGODB_URI=mongodb://admin:SECRET@localhost:27017/polyglot?authSource=admin

# MinIO / S3 Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secure_password_here
S3_BUCKET=polyglot-uploads-dev
S3_REGION=us-east-1

# Application Configuration
CORS_ORIGINS=http://localhost:3000
COOKIE_KEY=your_secure_random_cookie_key_here
TEST_MODE=true

# External Services (Auth0 & OpenAI)
OPENAI_SECRET_KEY=your_openai_secret_key_here
OPENAI_ENDPOINT=https://api.openai.com/v1
AUTH0_ISSUER_BASE_URL=https://your-auth0-tenant.us.auth0.com/
AUTH0_AUDIENCE=your_auth0_api_audience_here