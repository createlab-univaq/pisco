# Database Configuration
MONGODB_URI=mongodb://admin:SECRET@localhost:27017/polyglot?authSource=admin
# Optional: PEM contents of a Mongo TLS client certificate. Leave unset unless
# you need it -- see the note in README about how MONGO_URL is assembled.
MONGODB_CERTIFICATE=

# MinIO / S3 Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secure_password_here
S3_BUCKET=polyglot-uploads-dev
S3_REGION=us-east-1

# Application Configuration
CORS_ORIGINS=http://localhost:3000
TEST_MODE=true
# Public host of this backend, embedded into the generated notebooks'
# `--serverurl`. Defaults to localhost:5000, which breaks those links in prod.
DOMAIN_APP_DEPLOY=localhost:5000

# External Services (Google Sign-In & OpenAI)
OPENAI_SECRET_KEY=your_openai_secret_key_here
OPENAI_ENDPOINT=https://api.openai.com/v1

# Must be the same OAuth client id the editor signs in with: it is the
# `aud` every incoming Google ID token is checked against.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Shared secret allowing trusted services (game-api) to read the flow catalogue
# at GET /api/flows/catalog. Must match game-api's POLYGLOT_SERVICE_TOKEN.
# Generate with: openssl rand -base64 32
# Named APP_SERVICE_TOKEN because Coolify reserves the SERVICE_* prefix.
APP_SERVICE_TOKEN=your_shared_service_token_here