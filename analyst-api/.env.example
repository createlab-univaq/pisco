# Copy to .env and fill in. .env is git-ignored -- never commit real values.
#
# Two consumers, and they do not overlap:
#   docker-compose.dev.yml  -- only reads the POSTGRES_* block below (all optional,
#                              the defaults already match application-local.yaml).
#   docker-compose.yml      -- reads everything under "Deployment". On Coolify these
#                              are set in the app's environment, not in a .env file.

# --- Local dev database (docker-compose.dev.yml) ---
POSTGRES_DB=analyst_dashboard
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst
POSTGRES_PORT=5432

# --- Deployment (docker-compose.yml) ---

# Connection to the Postgres resource. On Coolify use the database's internal
# hostname, not localhost.
DB_URL=jdbc:postgresql://postgres:5432/analyst_dashboard
DB_USER=analyst
DB_PASSWORD=change-me

# Signing key for the analyst JWTs, base64-encoded. HS512 needs at least 64 bytes.
# Generate one with:  openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=PT8H

# Comma-separated allowlist. No wildcard: the browser dashboard sends the token
# in a header, but reflecting arbitrary origins is still not worth it.
CORS_ORIGINS=https://dashboard.example.com
